{{- $profile := index . "profile" | default "private" -}}
Include ~/.orbstack/ssh/config

Host *
{{- if eq $profile "work" }}
	IdentityAgent "~/.bitwarden-ssh-agent.sock"
{{- else }}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}

# Include custom configs
Include ~/.ssh/configs/*.config

{{ if eq $profile "work" -}}
# BEGIN: Upsun certificate configuration
Host *.platform.sh *.upsun.com
  Include {{ .chezmoi.homeDir }}/.upsun-cli/ssh/*.config
Host *
# END: Upsun certificate configuration

# BEGIN: Upsun (formerly Platform.sh) certificate configuration
Host *.platform.sh
  Include {{ .chezmoi.homeDir }}/.platformsh/ssh/*.config
Host *
# END: Upsun (formerly Platform.sh) certificate configuration
{{ end -}}