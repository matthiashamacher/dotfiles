[user]
	name = Matthias Hamacher
	email = {{ onepasswordRead "op://Private/i7ele4uunzhsfftktty3xw7l7i/username" }}
	signingkey = {{ onepasswordRead "op://Private/i7ele4uunzhsfftktty3xw7l7i/ebdajaradpqgri33hhami2jyre" }}
[commit]
	gpgsign = true
[gpg]
	program = /opt/homebrew/bin/gpg
	format = openpgp
[core]
	excludesfile = /Users/matthiashamacher/.gitignore
	whitespace = space-before-tab,-indent-with-non-tab,trainiling-space
	trustctime = false
	precomposeunicode = false
	untrackedCache = true
[apply]
	whitespace = fix
[color]
	ui = auto
[diff]
	renames = copies
	colorMoved = zebra
[diff "bin"]
	textconv = hexdu
[help]
	autocorrect = 1
[init]
	defaultBranch = main
[push]
	autoSetupRemove = true
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[tag]
	gpgsign = true
[includeIf "gitdir:~/dev/MAHA Digital GmbH/"]
	path = ~/.gitconfig-maha-digital
